erDiagram
    users {
        UUID id PK
        TEXT apple_user_id UK
        TEXT email
        TEXT voice_persona
    }
    data_sources {
        UUID id PK
        TEXT name UK
        TEXT display_name
        TEXT extraction_prompt
        BOOL is_active
    }
    categories {
        UUID id PK
        TEXT name UK
        TEXT display_name
        UUID parent_category_id FK
    }
    raw_content {
        UUID id PK
        UUID user_id FK
        TEXT content_type
        TEXT content
        TIMESTAMP content_date
        TEXT processing_status
        UUID source_id FK
        JSONB metadata
    }
    goals {
        UUID id PK
        UUID user_id FK
        TEXT title
        TEXT description
        BOOL is_active
        VECTOR embedding
    }
    insight_units {
        UUID id PK
        UUID user_id FK
        UUID raw_content_id FK
        TEXT content
        TEXT primary_category
        TEXT sentiment
        DECIMAL confidence_score
        DECIMAL intensity
        BOOL is_inferred
        VECTOR embedding
    }
    insight_connections {
        UUID id PK
        UUID source_insight_id FK
        UUID target_insight_id FK
        TEXT connection_type
        DECIMAL strength
        TEXT reasoning
    }
    patterns {
        UUID id PK
        UUID user_id FK
        TEXT title
        TEXT description
        TEXT pattern_type
        TEXT frequency
        DECIMAL confidence_score
        BOOL is_active
        TEXT user_feedback
    }
    pattern_insights {
        UUID pattern_id PK
        UUID insight_id PK
        DECIMAL relevance_score
    }
    observations {
        UUID id PK
        UUID user_id FK
        UUID goal_id FK
        UUID raw_content_id FK
        TEXT content
        TEXT reason_why
        DECIMAL confidence_score
        TIMESTAMP observation_date
        VECTOR embedding
    }
    insights {
        UUID id PK
        UUID user_id FK
        UUID goal_id FK
        TEXT title
        TEXT content
        TEXT evidence_summary
        DECIMAL confidence_score
        VECTOR embedding
    }
    pipeline_runs {
        UUID id PK
        UUID user_id FK
        TEXT run_type
        TEXT status
        INT observations_created
        INT insights_created
    }
    podcast_episodes {
        UUID id PK
        UUID user_id FK
        TEXT title
        TEXT script
        TEXT audio_url
        INT duration_seconds
        TEXT mood
        TEXT generation_type
        TEXT status
        UUID previous_episode_id FK
        JSONB outline
        JSONB research_citations
    }
    processing_queue {
        UUID id PK
        TEXT job_type
        JSONB payload
        TEXT status
        INT priority
    }
    analytics_cache {
        UUID id PK
        UUID user_id FK
        TEXT cache_key
        JSONB cache_value
        TIMESTAMP expires_at
    }

    users ||--o{ raw_content : "uploads"
    users ||--o{ goals : "sets"
    users ||--o{ insight_units : "has"
    users ||--o{ observations : "has"
    users ||--o{ insights : "has"
    users ||--o{ patterns : "has"
    users ||--o{ podcast_episodes : "receives"
    users ||--o{ pipeline_runs : "triggers"
    users ||--o{ analytics_cache : "cached"
    data_sources ||--o{ raw_content : "provides"
    raw_content ||--o{ insight_units : "legacy extraction"
    raw_content ||--o{ observations : "goals extraction"
    goals ||--o{ observations : "tracked by"
    goals ||--o{ insights : "synthesized for"
    insight_units ||--o{ insight_connections : "source"
    insight_units ||--o{ insight_connections : "target"
    patterns ||--o{ pattern_insights : "has"
    insight_units ||--o{ pattern_insights : "supports"
