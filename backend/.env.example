# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Anthropic (Claude) — used for all intelligence tasks
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenAI — used ONLY for embeddings
OPENAI_API_KEY=sk-your-openai-api-key

# ElevenLabs — text-to-speech, proxied via POST /speech/synthesize so the key
# never ships in the iOS binary
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# JWT Configuration (for Sign in with Apple)
JWT_SECRET=your-jwt-secret-key
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_CLIENT_ID=com.shauryanarang.Retrospect

# Admin Dashboard
ADMIN_SECRET=your-admin-secret

# Invites (BE0.12). INVITE_CODE_KEY: openssl rand -hex 32; without it no invite can be made.
INVITE_CODE_KEY=
INVITE_BASE_URL=https://retrospect-api.onrender.com
# Where the invite link page's download button goes (TestFlight or the App Store); no button when empty.
INVITE_APP_URL=

# Retrospect Agent (private service)
AGENT_SERVICE_URL=http://retrospect-agent:3001
INTERNAL_API_SECRET=shared-secret-used-by-retrospect-api-and-retrospect-agent
INTEGRATION_OAUTH_CALLBACK_BASE_URL=http://localhost:3000
INTEGRATION_APP_REDIRECT_URL=retrospect://integration-connected
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
