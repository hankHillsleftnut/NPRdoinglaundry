# Local staging for the backend (docs/team/staging.md). Copy to .env.staging
# (gitignored) and fill in the blanks. Never commit .env.staging; never paste
# its values into a PR, a report or a log.

# --- Which environment this is. Staging scripts refuse to run without it.
RETROSPECT_ENV=staging
# Read this file instead of .env, and let it win over the shell, so nothing is
# filled in from another environment.
DOTENV_CONFIG_PATH=.env.staging
# development keeps POST /auth/dev/test-user on (it 404s in production).
NODE_ENV=development
PORT=3000

# --- The staging Supabase project (retrospect-staging), never production's.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres string, for npm run staging:migrate only.
DATABASE_URL=
# Path to Supabase's CA certificate (dashboard → Database settings → SSL
# configuration → download), so the Postgres connection is verified.
DATABASE_CA_CERT=

# --- Generated on this Mac: openssl rand -hex 32. INTERNAL_API_SECRET must be
# the same value as in the agent's .env.staging.
JWT_SECRET=
INTERNAL_API_SECRET=
ADMIN_SECRET=
AGENT_SERVICE_URL=http://localhost:3001

# --- Model providers. A placeholder keeps model calls off (they fail, nothing
# is spent); real keys only when a test needs a real model, logged as test spend.
ANTHROPIC_API_KEY=staging-no-model-key
OPENAI_API_KEY=staging-no-model-key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Sign in with Apple (BE0.4, BE0.5). Empty until the founder's key exists.
APPLE_CLIENT_ID=com.shauryanarang.Retrospect
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REVOKE_ENABLED=false

# --- Invites (BE0.12). INVITE_CODE_KEY: openssl rand -base64 32.
INVITE_CODE_KEY=
INVITE_BASE_URL=http://localhost:3000

# --- Push (BE2.6, BE2.7) and payments (BE2.8). Empty until those bytes.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.shauryanarang.Retrospect
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=

# --- Minimum app version (BE0.10).
MIN_APP_VERSION=

# --- Integrations. Empty: connecting a provider on staging is out of scope.
INTEGRATION_OAUTH_CALLBACK_BASE_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Errors. With a DSN set, staging errors are tagged "staging" (RETROSPECT_ENV).
SENTRY_DSN=
